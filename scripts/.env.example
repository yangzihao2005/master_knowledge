# =====================================================================
# B 站收藏夹 ➔ Obsidian 同步配置
# 用法：把本文件复制为 scripts/.env，然后填写下面两项必填内容。
#   Windows PowerShell:  Copy-Item scripts/.env.example scripts/.env
# =====================================================================

# 【必填】你的 B 站 UID（打开个人空间，地址栏 space.bilibili.com/ 后面那串数字）
BILI_UID=

# 【可选】B 站登录 Cookie 中的 SESSDATA，用于读取私密收藏夹 / 降低风控概率
# 获取方式：浏览器登录 B 站 → F12 → Application → Cookies → bilibili.com → SESSDATA
BILI_SESSDATA=

# 【必填】DeepSeek 官方 API Key（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=

# 【可选】DeepSeek 接口地址与模型
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 【可选】Obsidian 仓库根目录，默认自动定位到 scripts/ 的上一级
# VAULT_DIR=D:/master_knowledge

# 【可选】AI 分类并发数（1-8，默认 4）与本地服务端口（默认 5055）
AI_CONCURRENCY=4
BILI_SYNC_PORT=5055
