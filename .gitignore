# ---------- Obsidian 本地状态（每次操作都会变，不入库）----------
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/*.log

# 可重装的插件二进制（克隆后由 Obsidian 自行安装）
.obsidian/plugins/
.obsidian/plugins-backup/

# ---------- AI 会话记录（含对话全文与切片，不入库）----------
.claudian/

# ---------- 回收站 ----------
.trash/

# ---------- 系统与临时文件 ----------
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.swp
*~
~$*
